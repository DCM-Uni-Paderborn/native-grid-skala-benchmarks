&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME G12_MgS_hybrid-one-center_v1p0777777778_k444
   RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
   METHOD QUICKSTEP
   STRESS_TENSOR ANALYTICAL
   &SUBSYS
      &KIND Mg
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q10
         POTENTIAL GTH-PBE-q10
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.90
      &END KIND
      &KIND S
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q6
         POTENTIAL GTH-PBE-q6
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.80
      &END KIND
      &CELL
         ABC 5.3191598566 5.3191598566 5.3191598566
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC XYZ
      &END CELL
      &COORD
         SCALED
         Mg  0.000000000  0.000000000  0.000000000
         Mg  0.000000000  0.500000000  0.500000000
         Mg  0.500000000  0.000000000  0.500000000
         Mg  0.500000000  0.500000000  0.000000000
         S   0.500000000  0.000000000  0.000000000
         S   0.000000000  0.500000000  0.000000000
         S   0.000000000  0.000000000  0.500000000
         S   0.500000000  0.500000000  0.500000000
      &END COORD
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      CHARGE 0
      MULTIPLICITY 1
      UKS .FALSE.
      &KPOINTS
         SCHEME MONKHORST-PACK 4 4 4
         GAMMA_CENTERED .TRUE.
         SYMMETRY .TRUE.
         FULL_GRID .FALSE.
         EPS_SYMMETRY 1.0E-8
         PARALLEL_GROUP_SIZE -1
         WAVEFUNCTIONS COMPLEX
      &END KPOINTS
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_GAPW_DENSITY_PARTITION HARD_MINUS_SOFT
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .TRUE.
               PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 5e-6
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &DIAGONALIZATION
            ALGORITHM STANDARD
         &END DIAGONALIZATION
         &MIXING
            ALPHA 0.10
            BETA 1.50
            METHOD DIRECT_P_MIXING
            NBUFFER 8
         &END MIXING
         &OUTER_SCF
            EPS_SCF 5e-6
            MAX_SCF 5
         &END OUTER_SCF
      &END SCF
      &QS
         EPS_DEFAULT 1e-12
         EPSFIT 1.0E-4
         EPSISO 1.0E-12
         EPSRHO0 1.0E-6
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW
      &END QS
      &POISSON
         PERIODIC XYZ
         POISSON_SOLVER PERIODIC
      &END POISSON
      &MGRID
         CUTOFF 800
         NGRIDS 5
         REL_CUTOFF 60
      &END MGRID
   &END DFT
&END FORCE_EVAL
