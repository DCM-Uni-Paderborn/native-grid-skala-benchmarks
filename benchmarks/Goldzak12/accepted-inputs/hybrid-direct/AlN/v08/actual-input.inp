&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME G12_AlN_hybrid-direct_v1p0555555556_k555
   RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
   METHOD QUICKSTEP
   STRESS_TENSOR ANALYTICAL
   &SUBSYS
      &KIND Al
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q3
         POTENTIAL GTH-PBE-q3
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.90
      &END KIND
      &KIND N
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.40
      &END KIND
      &CELL
         ABC 4.4474355339 4.4474355339 4.4474355339
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC XYZ
      &END CELL
      &COORD
         SCALED
         Al  0.000000000  0.000000000  0.000000000
         Al  0.000000000  0.500000000  0.500000000
         Al  0.500000000  0.000000000  0.500000000
         Al  0.500000000  0.500000000  0.000000000
         N   0.250000000  0.250000000  0.250000000
         N   0.250000000  0.750000000  0.750000000
         N   0.750000000  0.250000000  0.750000000
         N   0.750000000  0.750000000  0.250000000
      &END COORD
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      CHARGE 0
      MULTIPLICITY 1
      UKS .FALSE.
      &KPOINTS
         SCHEME MONKHORST-PACK 5 5 5
         GAMMA_CENTERED .TRUE.
         SYMMETRY .TRUE.
         FULL_GRID .FALSE.
         INVERSION_SYMMETRY_ONLY .TRUE.
         EPS_SYMMETRY 1.0E-8
         PARALLEL_GROUP_SIZE 0
         WAVEFUNCTIONS COMPLEX
      &END KPOINTS
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_GAPW_DENSITY_PARTITION HARD_MINUS_SOFT
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .FALSE.
               PSEUDOPOTENTIAL_GAPW_REPRESENTATION DIRECT_VALENCE
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 5.0E-7
         MAX_SCF 50
         SCF_GUESS RESTART
         &OT
            ALGORITHM IRAC
            ENERGY_GAP 1.0E-3
            MINIMIZER DIIS
            PRECONDITIONER FULL_ALL
            STEPSIZE 0.005
         &END OT

         &OUTER_SCF
            EPS_SCF 5.0E-7
            MAX_SCF 4
         &END OUTER_SCF
      &END SCF
      &QS
         EPS_DEFAULT 1e-12
         EPSFIT 1.0E-4
         EPSISO 1.0E-12
         EPSRHO0 1.0E-6
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW
      &END QS
      &POISSON
         PERIODIC XYZ
         POISSON_SOLVER PERIODIC
      &END POISSON
      &MGRID
         CUTOFF 800
         NGRIDS 5
         REL_CUTOFF 60
      &END MGRID
   &END DFT
&END FORCE_EVAL
