&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND O
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.4
      &END KIND
      &KIND H
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.0
      &END KIND
      &KIND C
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.52
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         C       -1.3590099991       -0.1771700012       -0.4540500014
         H       -0.8373200003       -1.1172700010       -0.6144800002
         O       -2.5748199988       -0.5135200000        0.2076300024
         C       -0.4989499998        0.7890399989        0.3558600005
         H       -1.0488999984        1.7281499980        0.4597900025
         H       -0.3764699976        0.3914200000        1.3674900004
         C        0.8708299990        1.0551399979       -0.2859000004
         H        1.2003800019        2.0707100025       -0.0537799995
         H        0.7885699996        0.9911799995       -1.3738299984
         H       -3.0805599984        0.2971399995        0.3108299992
         H       -1.5562300009        0.2544499986       -1.4412100004
         C        1.9663299988        0.1054200010        0.1879700001
         H        2.8963000015        0.3267899997       -0.3340899993
         H        2.1433700024        0.2555499993        1.2577199987
         O        1.6895199982       -1.2680599997       -0.0816100005
         H        1.0781099984       -1.5800100024        0.5901199994
      &END COORD
      &CELL
         ABC 31.0 29.0 28.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE 0
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .FALSE.
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-07
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &OUTER_SCF
            EPS_SCF 1e-07
            MAX_SCF 20
         &END OUTER_SCF
         &OT
            ENERGY_GAP 0.001
            MINIMIZER DIIS
            PRECONDITIONER FULL_ALL
            STEPSIZE 0.10
         &END OT
      &END SCF
      &QS
         EPS_DEFAULT 1e-14
         EPSFIT 0.0001
         EPSISO 1e-12
         EPSRHO0 1e-06
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 640.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME 53d4e0f05e30_gapw_ae
   RUN_TYPE ENERGY
&END GLOBAL
