&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND H
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.0
      &END KIND
      &KIND C
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.52
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         C        2.5453099977        0.8540699990       -0.2157300016
         C        2.0606399983       -0.4722899991        0.3583800006
         C        0.6950300005       -0.9000799995       -0.1729499982
         C       -0.4402400003        0.0444500020        0.2025999984
         C       -1.8033999975       -0.4588499986       -0.2547499998
         C       -2.9321100002        0.4942900018        0.1155499980
         H        1.8988099977        1.6790099990        0.0779000026
         H        2.5638900022        0.8172699997       -1.3055099979
         H        3.5521599980        1.0874199982        0.1270599992
         H        2.0147499993       -0.4052600002        1.4479899987
         H        2.7909300025       -1.2498999978        0.1279699988
         H        0.4590600026       -1.8977300000        0.2057499998
         H        0.7441299991       -0.9872800005       -1.2624500015
         H       -0.2661200018        1.0321600012       -0.2300199982
         H       -0.4516599990        0.1799299991        1.2886499992
         H       -1.9892999993       -1.4406600001        0.1864699997
         H       -1.7849399998       -0.6062000015       -1.3370500021
         H       -3.8999899989        0.1210299984       -0.2154300004
         H       -2.7773300000        1.4724300006       -0.3395899974
         H       -2.9796399987        0.6361700004        1.1951500006
      &END COORD
      &CELL
         ABC 33.0 29.0 28.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE 0
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .FALSE.
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-07
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &OUTER_SCF
            EPS_SCF 1e-07
            MAX_SCF 20
         &END OUTER_SCF
         &OT
            ENERGY_GAP 0.001
            MINIMIZER DIIS
            PRECONDITIONER FULL_ALL
            STEPSIZE 0.10
         &END OT
      &END SCF
      &QS
         EPS_DEFAULT 1e-14
         EPSFIT 0.0001
         EPSISO 1e-12
         EPSRHO0 1e-06
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 640.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME 18523213f913_gapw_ae
   RUN_TYPE ENERGY
&END GLOBAL
