&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND N
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.4
      &END KIND
      &KIND H
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.0
      &END KIND
      &KIND C
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.52
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         C       -1.9621299987       -1.3046200012       -1.2052700015
         C       -1.3456900001       -1.8582199996       -0.0810000020
         C       -1.5286600006       -1.2204399986        1.1454699974
         C       -2.3125300016       -0.0681500024        1.1927500020
         C       -2.8928600004        0.4191299995        0.0113899997
         N       -2.7153400013       -0.1965500000       -1.1751800010
         H       -1.0663000013       -1.6120399983        2.0529600018
         H       -1.8449999992       -1.7738900018       -2.1869699976
         H       -0.7407599975       -2.7608199991       -0.1691000012
         H       -2.4738500024        0.4561700018        2.1362199980
         C       -3.7557999989        1.6530600006        0.0035800002
         H       -3.6802300007        2.2098699985        0.9463299977
         H       -3.4695600022        2.3099300005       -0.8288399990
         H       -4.8109599997        1.3798199987       -0.1521099995
      &END COORD
      &CELL
         ABC 30.0 31.0 30.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE 0
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .TRUE.
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-07
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &OUTER_SCF
            EPS_SCF 1e-07
            MAX_SCF 20
         &END OUTER_SCF
         &OT
            ENERGY_GAP 0.001
            MINIMIZER DIIS
            PRECONDITIONER FULL_ALL
            STEPSIZE 0.10
         &END OT
      &END SCF
      &QS
         EPS_DEFAULT 1e-14
         EPSFIT 0.0001
         EPSISO 1e-12
         EPSRHO0 1e-06
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 640.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME 63954fbc43c2_gapw_ae
   RUN_TYPE ENERGY
&END GLOBAL
