&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND O
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.4
      &END KIND
      &KIND N
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.4
      &END KIND
      &KIND H
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.0
      &END KIND
      &KIND C
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.52
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         N       -0.0086499995       -1.3041400004       -0.0192100006
         H       -0.0110000014       -2.3147500006       -0.0033499987
         C       -1.2665899983       -0.6859299993       -0.0491500005
         O       -2.2850000018       -1.3566100005       -0.0589999993
         C       -1.1946000003        0.7639899986       -0.0654000007
         H       -2.1105199988        1.3274100020       -0.1079500025
         C        0.0070299975        1.3737800018       -0.0194700012
         H        0.1125899976        2.4484200000       -0.0212900004
         N        1.1767500010        0.6662300018        0.0386700004
         H        2.0659399991        1.1327200017        0.1025199987
         C        1.2354099986       -0.7158900021        0.0626000024
         O        2.2786199979       -1.3352399991        0.1410099995
      &END COORD
      &CELL
         ABC 30.0 30.0 26.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE 0
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .TRUE.
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-07
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &OUTER_SCF
            EPS_SCF 1e-07
            MAX_SCF 20
         &END OUTER_SCF
         &OT
            ENERGY_GAP 0.001
            MINIMIZER DIIS
            PRECONDITIONER FULL_ALL
            STEPSIZE 0.10
         &END OT
      &END SCF
      &QS
         EPS_DEFAULT 1e-14
         EPSFIT 0.0001
         EPSISO 1e-12
         EPSRHO0 1e-06
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 640.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME f431d6d4b95b_gapw_ae
   RUN_TYPE ENERGY
&END GLOBAL
