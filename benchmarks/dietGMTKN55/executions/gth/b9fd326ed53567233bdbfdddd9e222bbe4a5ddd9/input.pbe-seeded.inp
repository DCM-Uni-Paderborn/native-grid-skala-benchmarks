&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND H
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
         POTENTIAL GTH-PBE-q1
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.0
      &END KIND
      &KIND F
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q7
         POTENTIAL GTH-PBE-q7
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.3
      &END KIND
      &KIND C
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
         POTENTIAL GTH-PBE-q4
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.52
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         F        1.8235599982        0.0005200013        0.0001100001
         C        0.0001399991       -0.0000900025       -0.0001799996
         H        0.0000599981       -0.3048900009        1.0250700003
         H        0.0002899997        1.0401799994       -0.2489299977
         H       -0.0000900025       -0.7362600015       -0.7761799979
         F       -1.8239599980        0.0005399989        0.0001100001
      &END COORD
      &CELL
         ABC 29.0 27.0 27.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      WFN_RESTART_FILE_NAME pbe-seed.wfn
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE -1
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_GAPW_DENSITY_PARTITION HARD_MINUS_SOFT
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .FALSE.
               PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-07
         MAX_SCF 75
         SCF_GUESS RESTART
         &OUTER_SCF
            EPS_SCF 1e-07
            MAX_SCF 10
         &END OUTER_SCF
         &OT
            ENERGY_GAP 0.001
            MINIMIZER DIIS
            PRECONDITIONER FULL_ALL
            STEPSIZE 0.05
         &END OT
      &END SCF
      &QS
         EPS_DEFAULT 1e-12
         EPSFIT 0.0001
         EPSISO 1e-12
         EPSRHO0 1e-06
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW_XC
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 400.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME b9fd326ed535_gapwxc_gth_paw
   RUN_TYPE ENERGY
&END GLOBAL
