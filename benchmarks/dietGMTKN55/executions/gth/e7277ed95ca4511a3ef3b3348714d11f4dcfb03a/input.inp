&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND N
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q5
         POTENTIAL GTH-PBE-q5
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.4
      &END KIND
      &KIND H
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
         POTENTIAL GTH-PBE-q1
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.0
      &END KIND
      &KIND C
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
         POTENTIAL GTH-PBE-q4
         RADIAL_GRID 100
         LEBEDEV_GRID 434
         HARD_EXP_RADIUS 1.52
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         C       -0.0474999995        0.9518199996        0.0000000000
         C        0.0553300018       -1.2085100001        0.6721500025
         C        0.0553300018       -1.2085100001       -0.6721500025
         N       -0.0068300003        0.1134200015       -1.0558900007
         N       -0.0068300003        0.1134200015        1.0558900007
         H        0.0964800018       -2.0286100025        1.3710400016
         H        0.0964800018       -2.0286100025       -1.3710400016
         C       -0.0268999985        0.5655099994       -2.4237699994
         C       -0.0268999985        0.5655099994        2.4237699994
         H        0.8604400014        0.2291399977       -2.9613499991
         H       -0.9121000005        0.2011799990       -2.9468799976
         H       -0.0426600018        1.6519599999       -2.4198000009
         H       -0.9121000005        0.2011799990        2.9468799976
         H        0.8604400014        0.2291399977        2.9613499991
         H       -0.0426600018        1.6519599999        2.4198000009
      &END COORD
      &CELL
         ABC 27.0 29.0 31.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE 0
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_GAPW_DENSITY_PARTITION HARD_MINUS_SOFT
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .TRUE.
               PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-07
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &OUTER_SCF
            EPS_SCF 1e-07
            MAX_SCF 20
         &END OUTER_SCF
         &OT
            ENERGY_GAP 0.001
            MINIMIZER DIIS
            PRECONDITIONER FULL_ALL
            STEPSIZE 0.10
         &END OT
      &END SCF
      &QS
         EPS_DEFAULT 1e-12
         EPSFIT 0.0001
         EPSISO 1e-12
         EPSRHO0 1e-06
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW_XC
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 400.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME e7277ed95ca4_gapwxc_gth_paw
   RUN_TYPE ENERGY
&END GLOBAL
