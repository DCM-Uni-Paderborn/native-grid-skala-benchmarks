&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND O
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.4
      &END KIND
      &KIND N
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.4
      &END KIND
      &KIND H
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.0
      &END KIND
      &KIND C
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.52
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         C        0.0135500005       -0.1511700009       -0.3618799999
         C        0.1275900019        0.6504299980        1.7533600004
         C        0.1051199998       -0.6943700001        1.8358100009
         N        0.0366199996       -1.1539899992        0.5395799985
         N        0.0714399977        0.9524399995        0.4119900019
         H        0.1803800008        1.3974199988        2.5292000018
         H        0.1338899995       -1.3430000019        2.6966599982
         C       -0.0062500009       -2.5464499989        0.1720200010
         C        0.0801900011        2.2939800014       -0.1226900009
         H        0.8719999993       -3.0771299987        0.5415599997
         H       -0.9000500004       -3.0314799975        0.5667799982
         H       -0.0219500008       -2.6087200011       -0.9126500008
         H       -0.7893299986        2.8558100019        0.2209999980
         H        0.9826599976        2.8262799980        0.1795800013
         H        0.0569199994        2.2296999990       -1.2081699984
         O       -0.0320400026        0.6161600003       -3.1849499983
         H        0.0631800018        0.2031400026       -2.3023499974
         H       -0.9739300025        0.5809400025       -3.3548499989
      &END COORD
      &CELL
         ABC 32.0 36.0 37.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE 0
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .TRUE.
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-06
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &MIXING
            ALPHA 0.1
            METHOD DIRECT_P_MIXING
            NBUFFER 15
         &END MIXING
         &DIAGONALIZATION
         &END DIAGONALIZATION
      &END SCF
      &QS
         EPS_DEFAULT 1e-14
         EPSFIT 0.0001
         EPSISO 1e-12
         EPSRHO0 1e-06
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 1200.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME c3b0d87b540d_gapw_ae
   RUN_TYPE ENERGY
&END GLOBAL
