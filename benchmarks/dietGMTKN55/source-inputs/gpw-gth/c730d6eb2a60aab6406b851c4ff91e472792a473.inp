&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND N
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q5
         POTENTIAL GTH-PBE-q5
      &END KIND
      &KIND H
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
         POTENTIAL GTH-PBE-q1
      &END KIND
      &KIND Cl
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q7
         POTENTIAL GTH-PBE-q7
      &END KIND
      &KIND C
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
         POTENTIAL GTH-PBE-q4
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         N        -2.4871700013        0.1746200021       -0.1204499990
         H        -1.4936100009        0.1248999984       -0.3221200002
         H        -2.7954900019        1.0883699983       -0.4234399997
         H        -2.9392599992       -0.4917099983       -0.7308399992
         C         0.8901499997       -0.0150100005       -0.5370199979
         Cl        1.9304799996       -0.1698199997       -1.8814100002
         C         1.6355800020       -0.1305100018        0.7280400009
         H         2.7276900026       -0.1356699982        0.7079600012
         H         1.2560300025        0.6291099985        1.4170699997
         H         1.2755900009       -1.0742900004        1.1622200013
      &END COORD
      &CELL
         ABC 36.0 33.0 34.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE 0
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .TRUE.
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-06
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &MIXING
            ALPHA 0.1
            METHOD DIRECT_P_MIXING
            NBUFFER 15
         &END MIXING
         &DIAGONALIZATION
         &END DIAGONALIZATION
      &END SCF
      &QS
         EPS_DEFAULT 1e-12
         METHOD GPW
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 1200.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME c730d6eb2a60_gpw_gth
   RUN_TYPE ENERGY
&END GLOBAL
