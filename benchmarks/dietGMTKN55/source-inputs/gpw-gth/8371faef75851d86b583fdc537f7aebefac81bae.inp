&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND H
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
         POTENTIAL GTH-PBE-q1
      &END KIND
      &KIND C
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
         POTENTIAL GTH-PBE-q4
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         C       -2.5304400016       -0.3015499983       -0.0118899981
         H       -2.5388099976       -0.9634999990       -0.8783000021
         H       -2.5823600014       -0.9278100019        0.8787000019
         H       -3.4328600016        0.3073599990       -0.0446499992
         C       -1.2699099979        0.5530599995       -0.0008200024
         H       -1.2865599979        1.2260500021        0.8595899999
         H       -1.2446399975        1.1872700016       -0.8896100008
         C        0.0000100014       -0.2852800005        0.0396399981
         H        0.0000100014       -0.9030699989        0.9427000008
         H        0.0000800010       -0.9735699979       -0.8095999994
         C        1.2699099979        0.5531000000       -0.0007300000
         H        1.2865299988        1.2260699997        0.8596899985
         H        1.2447599990        1.1872700016       -0.8895299998
         C        2.5304300002       -0.3015400022       -0.0116799994
         H        2.5388099976       -0.9635200019       -0.8780599991
         H        3.4328099996        0.3073999995       -0.0444000000
         H        2.5822500013       -0.9277499985        0.8789600025
      &END COORD
      &CELL
         ABC 37.0 33.0 32.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE 0
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .TRUE.
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-06
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &MIXING
            ALPHA 0.1
            METHOD DIRECT_P_MIXING
            NBUFFER 15
         &END MIXING
         &DIAGONALIZATION
         &END DIAGONALIZATION
      &END SCF
      &QS
         EPS_DEFAULT 1e-12
         METHOD GPW
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 1200.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME 8371faef7585_gpw_gth
   RUN_TYPE ENERGY
&END GLOBAL
