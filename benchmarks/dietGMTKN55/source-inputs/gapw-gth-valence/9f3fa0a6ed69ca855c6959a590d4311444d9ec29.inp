&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND H
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
         POTENTIAL GTH-PBE-q1
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.0
      &END KIND
      &KIND C
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
         POTENTIAL GTH-PBE-q4
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.52
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         C       -0.6061900000        0.0824699981       -2.9478399991
         H       -1.6680300005        0.0823699995       -2.9478399991
         C        0.6058499984        0.0821300018       -2.9475799985
         H        1.6676799974        0.0814599999       -2.9471200006
         C       -2.5304000011       -0.3208599976        0.6816599996
         H       -2.5387700024       -0.9828199997       -0.1847499991
         H       -2.5823200009       -0.9471300025        1.5722600011
         H       -3.4328200011        0.2880399983        0.6488999985
         C       -1.2698699974        0.5337399988        0.6927300006
         H       -1.2865199974        1.2067399975        1.5531399976
         H       -1.2446000023        1.1679500009       -0.1960599978
         C        0.0000500020       -0.3045899997        0.7331900011
         H        0.0000500020       -0.9223799981        1.6362499985
         H        0.0001200015       -0.9928899986       -0.1160500017
         C        1.2699499984        0.5337799993        0.6928199978
         H        1.2865800008        1.2067499990        1.5532400015
         H        1.2447999995        1.1679500009       -0.1959800021
         C        2.5304700007       -0.3208500014        0.6818699983
         H        2.5388499981       -0.9828400026       -0.1844999999
         H        3.4328500001        0.2880799988        0.6491499977
         H        2.5822900018       -0.9470699991        1.5725100002
      &END COORD
      &CELL
         ABC 37.0 33.0 35.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE 0
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .TRUE.
               PSEUDOPOTENTIAL_GAPW_REPRESENTATION DIRECT_VALENCE
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-06
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &MIXING
            ALPHA 0.1
            METHOD DIRECT_P_MIXING
            NBUFFER 15
         &END MIXING
         &DIAGONALIZATION
         &END DIAGONALIZATION
      &END SCF
      &QS
         EPS_DEFAULT 1e-12
         EPSFIT 0.0001
         EPSISO 1e-12
         EPSRHO0 1e-06
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 1200.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME 9f3fa0a6ed69_gapw_gth_valence
   RUN_TYPE ENERGY
&END GLOBAL
