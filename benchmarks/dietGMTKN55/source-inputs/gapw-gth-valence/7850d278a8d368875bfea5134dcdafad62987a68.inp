&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND O
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q6
         POTENTIAL GTH-PBE-q6
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.4
      &END KIND
      &KIND N
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q5
         POTENTIAL GTH-PBE-q5
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.4
      &END KIND
      &KIND H
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
         POTENTIAL GTH-PBE-q1
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.0
      &END KIND
      &KIND C
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
         POTENTIAL GTH-PBE-q4
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.52
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         N        1.3140500026        0.0546899990        0.0000000000
         H        2.3424799977        0.1059300008        0.0000000000
         C        0.7472299986       -1.2084999986        0.0000000000
         O        1.4499500023       -2.2215899984        0.0000000000
         C       -0.6995700023       -1.2303999975        0.0000000000
         H       -1.2055399983       -2.1799100010        0.0000000000
         C       -1.3779700005       -0.0639800013        0.0000000000
         H       -2.4568499993       -0.0172899975        0.0000000000
         N       -0.7307800011        1.1373399992        0.0000000000
         H       -1.2397899984        2.0058100002        0.0000000000
         C        0.6525700012        1.2689500016        0.0000000000
         O        1.2042100013        2.3489600002        0.0000000000
      &END COORD
      &CELL
         ABC 35.0 35.0 30.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE 0
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .TRUE.
               PSEUDOPOTENTIAL_GAPW_REPRESENTATION DIRECT_VALENCE
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-06
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &MIXING
            ALPHA 0.1
            METHOD DIRECT_P_MIXING
            NBUFFER 15
         &END MIXING
         &DIAGONALIZATION
         &END DIAGONALIZATION
      &END SCF
      &QS
         EPS_DEFAULT 1e-12
         EPSFIT 0.0001
         EPSISO 1e-12
         EPSRHO0 1e-06
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 1200.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME 7850d278a8d3_gapw_gth_valence
   RUN_TYPE ENERGY
&END GLOBAL
