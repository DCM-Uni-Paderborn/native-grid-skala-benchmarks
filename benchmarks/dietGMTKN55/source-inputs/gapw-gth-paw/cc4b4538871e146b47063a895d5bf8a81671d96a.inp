&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND O
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q6
         POTENTIAL GTH-PBE-q6
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.4
      &END KIND
      &KIND N
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q5
         POTENTIAL GTH-PBE-q5
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.4
      &END KIND
      &KIND H
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
         POTENTIAL GTH-PBE-q1
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.0
      &END KIND
      &KIND C
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
         POTENTIAL GTH-PBE-q4
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.52
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         N       -0.4244599994        1.9040399990        0.0000000000
         N        1.5727800023        0.7484799998        0.0000000000
         C       -0.4729200004       -0.4729499995        0.0000000000
         C        0.9339100022       -0.4234299983        0.0000000000
         C       -1.0934300014        0.7430900018        0.0000000000
         C        0.9593900013        2.0078399980        0.0000000000
         C       -1.2104399993       -1.7776800007        0.0000000000
         O        1.7131899995       -1.4567199992        0.0000000000
         O        1.5638799984        3.0280100026        0.0000000000
         H       -0.9283200017        2.7839299987        0.0000000000
         H        2.5909899980        0.7587299983        0.0000000000
         H       -2.1742299980        0.8202899982        0.0000000000
         H       -0.9942499999       -2.3753399974       -0.8887400017
         H       -0.9942499999       -2.3753399974        0.8887400017
         H       -2.2864799993       -1.6106899984        0.0000000000
         H        1.2446600004       -2.3022799978        0.0000000000
      &END COORD
      &CELL
         ABC 35.0 36.0 32.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE 1
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_GAPW_DENSITY_PARTITION HARD_MINUS_SOFT
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .TRUE.
               PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-06
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &MIXING
            ALPHA 0.1
            METHOD DIRECT_P_MIXING
            NBUFFER 15
         &END MIXING
         &DIAGONALIZATION
         &END DIAGONALIZATION
      &END SCF
      &QS
         EPS_DEFAULT 1e-12
         EPSFIT 0.0001
         EPSISO 1e-12
         EPSRHO0 1e-06
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 1200.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME cc4b4538871e_gapw_gth_paw
   RUN_TYPE ENERGY
&END GLOBAL
