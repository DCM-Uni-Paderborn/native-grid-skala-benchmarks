&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND N
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q5
         POTENTIAL GTH-PBE-q5
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.4
      &END KIND
      &KIND H
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
         POTENTIAL GTH-PBE-q1
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.0
      &END KIND
      &KIND C
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
         POTENTIAL GTH-PBE-q4
         RADIAL_GRID 50
         LEBEDEV_GRID 50
         HARD_EXP_RADIUS 1.52
      &END KIND
      &TOPOLOGY
         &CENTER_COORDINATES
         &END CENTER_COORDINATES
      &END TOPOLOGY
      &COORD
         C        0.0490400004       -0.0844799984        0.0214199981
         C        0.0490400004       -0.0844799984        1.5354900009
         N        1.4468299999       -0.0844799984        2.0458400018
         H        1.9644100010        0.7306099976        1.7080299978
         H        1.4763599986       -0.0799599995        3.0672999976
         H        1.9828299982       -0.9265899997        1.6742599985
         H       -0.4539599990        0.7915800019        1.9389799985
         H       -0.4311299976       -0.9748099977        1.9357699990
         H        0.5532399991        0.7980499977       -0.3690500018
         H        0.5494200011       -0.9688800008       -0.3671999983
         H       -0.9775800023       -0.0800199976       -0.3379599993
      &END COORD
      &CELL
         ABC 33.0 32.0 34.0
         ALPHA_BETA_GAMMA 90.0 90.0 90.0
         PERIODIC NONE
      &END CELL
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      MULTIPLICITY 1
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      UKS .FALSE.
      CHARGE 1
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
               TYPE DFTD3(BJ)
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_GAPW_DENSITY_PARTITION HARD_MINUS_SOFT
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .TRUE.
               PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         EPS_SCF 1e-06
         MAX_SCF 200
         SCF_GUESS ATOMIC
         &MIXING
            ALPHA 0.1
            METHOD DIRECT_P_MIXING
            NBUFFER 15
         &END MIXING
         &DIAGONALIZATION
         &END DIAGONALIZATION
      &END SCF
      &QS
         EPS_DEFAULT 1e-12
         EPSFIT 0.0001
         EPSISO 1e-12
         EPSRHO0 1e-06
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
         METHOD GAPW
      &END QS
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
      &MGRID
         CUTOFF 1200.0
         NGRIDS 5
         REL_CUTOFF 60.0
      &END MGRID
   &END DFT
&END FORCE_EVAL
&GLOBAL
   PRINT_LEVEL MEDIUM
   PROJECT_NAME 63e082274006_gapw_gth_paw
   RUN_TYPE ENERGY
&END GLOBAL
