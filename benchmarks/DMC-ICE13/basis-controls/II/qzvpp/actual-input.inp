      &SCF
         SCF_GUESS ATOMIC
         EPS_SCF 5.0E-7
         MAX_SCF 300
         &OT
            MINIMIZER DIIS
            ALGORITHM IRAC
            PRECONDITIONER FULL_ALL
            ENERGY_GAP 0.001
            STEPSIZE 0.10
         &END OT
         &OUTER_SCF
            EPS_SCF 5.0E-7
            MAX_SCF 2
         &END OUTER_SCF
         &PRINT
            &RESTART
               BACKUP_COPIES 1
               &EACH
                  QS_SCF 1
               &END EACH
            &END RESTART
         &END PRINT
      &END SCF
      &QS
         METHOD GAPW
         EPS_DEFAULT 1.0E-14
         EPSFIT 1.0E-4
         EPSISO 1.0E-12
         EPSRHO0 1.0E-6
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
      &END QS
      &MGRID
         CUTOFF 800
         REL_CUTOFF 60
         NGRIDS 5
      &END MGRID
      &POISSON
         PERIODIC XYZ
         POISSON_SOLVER PERIODIC
      &END POISSON
   &END DFT
&END FORCE_EVAL
