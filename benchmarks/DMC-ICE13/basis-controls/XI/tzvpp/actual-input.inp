         H 0.681542283813 0.231886124600 0.483718860411
         H 0.181545121451 0.268115437610 0.983717124954
         H 0.818453734438 0.268115437610 0.983717124954
         H 0.181544470274 0.731889793969 0.483716157428
         H 0.818454385616 0.731889793969 0.483716157428
         O 0.000000000000 0.665693806587 0.060774251003
         O 0.000000000000 0.334305132668 0.560768152462
         O 0.499999084712 0.165695920442 0.060776028717
         O 0.499999084712 0.834298726590 0.560780605833
