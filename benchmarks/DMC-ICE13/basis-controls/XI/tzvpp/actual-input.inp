&GLOBAL
   PROJECT_NAME ice13_XI_gapw-ae
   RUN_TYPE ENERGY
   PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND H
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.00
      &END KIND
      &KIND O
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.40
      &END KIND
      &CELL
         A 4.412173326207 0.000000000000 0.000000000000
         B 0.000000000000 7.663488095983 0.000000000000
         C 0.000000000000 0.000233800048 7.199592110162
         PERIODIC XYZ
      &END CELL
      &COORD
         SCALED
         H 0.000000000000 0.540722084567 0.019888574715
