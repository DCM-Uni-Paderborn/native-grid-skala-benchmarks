&GLOBAL
   PROJECT_NAME ice13_XV_gapw-ae
   RUN_TYPE ENERGY
   PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND H
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.00
      &END KIND
      &KIND O
         BASIS_SET TZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.40
      &END KIND
      &CELL
         A 6.258463095268 0.000000000000 0.000000000000
         B 0.008754854032 6.270005440632 0.000000000000
         C 0.001014554506 -0.006091448145 5.814604720753
         PERIODIC XYZ
      &END CELL
      &COORD
         SCALED
         H 0.246938000000 0.365195000000 0.351189000000
         H 0.250748000000 0.120022000000 0.346618000000
         H 0.254486000000 0.673857000000 0.625920000000
         H 0.680022000000 0.251295000000 0.872870000000
         H 0.368875000000 0.456547000000 0.700347000000
         H 0.375543000000 0.039945000000 0.701468000000
         H 0.130885000000 0.033403000000 0.705002000000
         H 0.040645000000 0.361422000000 0.776950000000
         H 0.458868000000 0.247942000000 0.011783000000
         H 0.048602000000 0.244336000000 0.012581000000
         H 0.541132000000 0.752058000000 0.988217000000
         H 0.951398000000 0.755664000000 0.987419000000
         H 0.753062000000 0.634805000000 0.648811000000
         H 0.749252000000 0.879978000000 0.653382000000
         H 0.745514000000 0.326143000000 0.374080000000
         H 0.319978000000 0.748705000000 0.127130000000
         H 0.631125000000 0.543453000000 0.299654000000
         H 0.624457000000 0.960055000000 0.298532000000
         H 0.869115000000 0.966597000000 0.294998000000
         H 0.959355000000 0.638578000000 0.223050000000
         O 0.254104000000 0.965453000000 0.627263000000
         O 0.971475000000 0.244485000000 0.863749000000
         O 0.251169000000 0.243887000000 0.241661000000
         O 0.244313000000 0.516373000000 0.617982000000
         O 0.522468000000 0.250316000000 0.856399000000
         O 0.748831000000 0.756113000000 0.758339000000
         O 0.755687000000 0.483627000000 0.382019000000
         O 0.477532000000 0.749684000000 0.143601000000
         O 0.028525000000 0.755515000000 0.136252000000
         O 0.745896000000 0.034547000000 0.372738000000
      &END COORD
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      CHARGE 0
      MULTIPLICITY 1
      UKS .FALSE.
      &KPOINTS
         SCHEME MONKHORST-PACK 3 3 3
         GAMMA_CENTERED .TRUE.
         SYMMETRY .TRUE.
         FULL_GRID .FALSE.
         INVERSION_SYMMETRY_ONLY .FALSE.
         WAVEFUNCTIONS COMPLEX
         PARALLEL_GROUP_SIZE 0
      &END KPOINTS
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               TYPE DFTD3(BJ)
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .FALSE.
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         SCF_GUESS ATOMIC
         EPS_SCF 5.0E-7
         MAX_SCF 300
         &OT
            MINIMIZER DIIS
            ALGORITHM IRAC
            PRECONDITIONER FULL_ALL
            ENERGY_GAP 0.001
            STEPSIZE 0.10
         &END OT
         &OUTER_SCF
            EPS_SCF 5.0E-7
            MAX_SCF 2
         &END OUTER_SCF
         &PRINT
            &RESTART
               BACKUP_COPIES 1
               &EACH
                  QS_SCF 1
               &END EACH
            &END RESTART
         &END PRINT
      &END SCF
      &QS
         METHOD GAPW
         EPS_DEFAULT 1.0E-14
         EPSFIT 1.0E-4
         EPSISO 1.0E-12
         EPSRHO0 1.0E-6
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
      &END QS
      &MGRID
         CUTOFF 800
         REL_CUTOFF 60
         NGRIDS 5
      &END MGRID
      &POISSON
         PERIODIC XYZ
         POISSON_SOLVER PERIODIC
      &END POISSON
   &END DFT
&END FORCE_EVAL
