&GLOBAL
   PROJECT_NAME basis_VIII_solid_qzvpp
   RUN_TYPE ENERGY
   PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND H
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.00
      &END KIND
      &KIND O
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.40
      &END KIND
      &CELL
         A 4.849465370000 0.000000000000 0.000000000000
         B 0.000000000000 4.849465370000 0.000000000000
         C 0.000000000000 0.000000000000 7.056513790000
         PERIODIC XYZ
      &END CELL
      &COORD
         SCALED
         H 0.398405026656 0.559560265506 0.987260807153
         H 0.898404988507 0.059560227358 0.487260822033
         H 0.237249787805 0.898404988507 0.237260814593
         H 0.059560227358 0.398405026656 0.737260829473
         H 0.898404988507 0.559560265506 0.100278229599
         H 0.898404988507 0.237249787805 0.100278229599
         H 0.059560227358 0.898404988507 0.850278222159
         H 0.237249787805 0.398405026656 0.350278237039
         H 0.737249749656 0.898404988507 0.850278222159
         H 0.737249749656 0.398405026656 0.737260829473
         H 0.398405026656 0.237249787805 0.987260807153
         H 0.559560265506 0.898404988507 0.237260814593
         H 0.559560265506 0.398405026656 0.350278237039
         H 0.898404988507 0.737249749656 0.487260822033
         H 0.398405026656 0.059560227358 0.600278244479
         H 0.398405026656 0.737249749656 0.600278244479
         O 0.398405026656 0.398405026656 0.902428832354
         O 0.398405026656 0.898404988507 0.152428839794
         O 0.898404988507 0.398405026656 0.652428854674
         O 0.898404988507 0.398405026656 0.185110204397
         O 0.898404988507 0.898404988507 0.935110196957
         O 0.398405026656 0.398405026656 0.435110211837
         O 0.898404988507 0.898404988507 0.402428847234
         O 0.398405026656 0.898404988507 0.685110219277
      &END COORD
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      CHARGE 0
      MULTIPLICITY 1
      UKS .FALSE.
      &KPOINTS
         SCHEME MONKHORST-PACK 3 3 3
         GAMMA_CENTERED .TRUE.
         SYMMETRY .TRUE.
         SYMMETRY_BACKEND SPGLIB
         SYMMETRY_REDUCTION_METHOD SPGLIB
         EPS_SYMMETRY 1.0E-4
         FULL_GRID .FALSE.
         INVERSION_SYMMETRY_ONLY .FALSE.
         WAVEFUNCTIONS COMPLEX
         PARALLEL_GROUP_SIZE 0
      &END KPOINTS
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               TYPE DFTD3(BJ)
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .FALSE.
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         SCF_GUESS ATOMIC
         EPS_SCF 5.0E-7
         MAX_SCF 300
         &OT
            MINIMIZER DIIS
            ALGORITHM IRAC
            PRECONDITIONER FULL_ALL
            ENERGY_GAP 0.001
            STEPSIZE 0.10
         &END OT
         &OUTER_SCF
            EPS_SCF 5.0E-7
            MAX_SCF 2
         &END OUTER_SCF
         &PRINT
            &RESTART
               BACKUP_COPIES 1
               &EACH
                  QS_SCF 1
               &END EACH
            &END RESTART
         &END PRINT
      &END SCF
      &QS
         METHOD GAPW
         EPS_DEFAULT 1.0E-14
         EPSFIT 1.0E-4
         EPSISO 1.0E-12
         EPSRHO0 1.0E-6
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
      &END QS
      &MGRID
         CUTOFF 800
         REL_CUTOFF 60
         NGRIDS 5
      &END MGRID
      &POISSON
         PERIODIC XYZ
         POISSON_SOLVER PERIODIC
      &END POISSON
   &END DFT
&END FORCE_EVAL
