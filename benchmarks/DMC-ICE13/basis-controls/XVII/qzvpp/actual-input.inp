&GLOBAL
   PROJECT_NAME basis_XVII_solid_qzvpp
   RUN_TYPE ENERGY
   PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND H
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.00
      &END KIND
      &KIND O
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.40
      &END KIND
      &CELL
         A 6.214323743331 0.000000000000 0.000000000000
         B 3.105477974166 5.383439384817 0.000000000000
         C 0.000020871626 0.000322248524 5.942880013768
         PERIODIC XYZ
      &END CELL
      &COORD
         SCALED
         H 0.917418215080 0.131855826927 0.195048174715
         H 0.003672097943 0.939916456627 0.528398502393
         H 0.109440633931 0.026241329627 0.861740318557
         H 0.712989062287 0.058342105467 0.260648819060
         H 0.281417440608 0.735367432777 0.594023556708
         H 0.036151458352 0.304024535141 0.927363497655
         H 0.654709009802 0.425669396050 0.431456644396
         H 0.972223191650 0.677339290788 0.764770006863
         H 0.403413135835 0.994686126558 0.098169022114
         H 0.573031983592 0.789330604437 0.280242381453
         H 0.690302183906 0.595378915946 0.613559852059
         H 0.767012047061 0.712729223341 0.946891882590
         O 0.109007692234 0.131908693731 0.989234123559
         O 0.812199459593 0.131311950491 0.322521439985
         O 0.109326295876 0.834733631641 0.655911074023
         O 0.578006725438 0.599063210647 0.490929549728
         O 0.875552580792 0.600532641560 0.824222899749
         O 0.576826786019 0.897878628246 0.157608254393
      &END COORD
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      CHARGE 0
      MULTIPLICITY 1
      UKS .FALSE.
      &KPOINTS
         SCHEME MONKHORST-PACK 3 3 3
         GAMMA_CENTERED .TRUE.
         SYMMETRY .TRUE.
         SYMMETRY_BACKEND SPGLIB
         SYMMETRY_REDUCTION_METHOD SPGLIB
         EPS_SYMMETRY 1.0E-4
         FULL_GRID .FALSE.
         INVERSION_SYMMETRY_ONLY .FALSE.
         WAVEFUNCTIONS COMPLEX
         PARALLEL_GROUP_SIZE 0
      &END KPOINTS
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               TYPE DFTD3(BJ)
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .FALSE.
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         SCF_GUESS ATOMIC
         EPS_SCF 5.0E-7
         MAX_SCF 300
         &OT
            MINIMIZER DIIS
            ALGORITHM IRAC
            PRECONDITIONER FULL_ALL
            ENERGY_GAP 0.001
            STEPSIZE 0.10
         &END OT
         &OUTER_SCF
            EPS_SCF 5.0E-7
            MAX_SCF 2
         &END OUTER_SCF
         &PRINT
            &RESTART
               BACKUP_COPIES 1
               &EACH
                  QS_SCF 1
               &END EACH
            &END RESTART
         &END PRINT
      &END SCF
      &QS
         METHOD GAPW
         EPS_DEFAULT 1.0E-14
         EPSFIT 1.0E-4
         EPSISO 1.0E-12
         EPSRHO0 1.0E-6
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
      &END QS
      &MGRID
         CUTOFF 800
         REL_CUTOFF 60
         NGRIDS 5
      &END MGRID
      &POISSON
         PERIODIC XYZ
         POISSON_SOLVER PERIODIC
      &END POISSON
   &END DFT
&END FORCE_EVAL
