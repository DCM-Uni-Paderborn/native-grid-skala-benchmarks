&GLOBAL
   PROJECT_NAME basis_IX_solid_qzvpp
   RUN_TYPE ENERGY
   PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND H
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.00
      &END KIND
      &KIND O
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.40
      &END KIND
      &CELL
         A 6.784903000000 0.000000000000 0.000000000000
         B 0.000000000000 6.784903000000 0.000000000000
         C 0.000000000000 0.000000000000 6.807916000000
         PERIODIC XYZ
      &END CELL
      &COORD
         SCALED
         H 0.993170000000 0.340009000000 0.190161000000
