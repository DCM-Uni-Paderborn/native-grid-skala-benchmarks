         H 0.690730000000 0.629654000000 0.606284000000
         H 0.340009000000 0.993170000000 0.809839000000
         H 0.164412000000 0.113981000000 0.716670000000
         O 0.114088000000 0.310030000000 0.267366000000
         O 0.189970000000 0.614088000000 0.517366000000
         O 0.810030000000 0.385912000000 0.017365000000
         O 0.385912000000 0.810030000000 0.982634000000
