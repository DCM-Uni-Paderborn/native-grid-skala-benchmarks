&GLOBAL
   PROJECT_NAME basis_Ih_solid_qzvpp
   RUN_TYPE ENERGY
   PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND H
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.00
      &END KIND
      &KIND O
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.40
      &END KIND
      &CELL
         A 7.678093000000 0.000000000000 0.000000000000
         B 3.839046000000 6.649423000000 0.000000000000
         C 0.000000000000 0.000000000000 7.234567000000
         PERIODIC XYZ
      &END CELL
      &COORD
         SCALED
         H 0.000007000000 0.334718000000 0.199799000000
         H 0.665252000000 0.000010000000 0.199780000000
