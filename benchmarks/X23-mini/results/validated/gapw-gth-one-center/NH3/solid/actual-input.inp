&GLOBAL
   PROJECT_NAME x23_NH3_solid_gapw-gth-one-center
   RUN_TYPE ENERGY
   PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND N
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q5
         POTENTIAL GTH-PBE-q5
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.40
      &END KIND
      &KIND H
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
         POTENTIAL GTH-PBE-q1
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.00
      &END KIND
      &CELL
         A 5.130500000000 0.000000000000 0.000000000000
         B 0.000000000000 5.130500000000 0.000000000000
         C 0.000000000000 0.000000000000 5.130500000000
         PERIODIC XYZ
      &END CELL
      &COORD
         SCALED
         N 0.203627114316 0.203621430660 0.203630402495
         N 0.703627028555 0.296379224247 0.796369780723
         N 0.796376203099 0.703621085664 0.296368679466
         N 0.296376359029 0.796379869408 0.703631030114
         H 0.362924549264 0.272160064321 0.103816846311
         H 0.272173109833 0.103811414092 0.362943826138
         H 0.103803989865 0.362910930709 0.272163642920
         H 0.862924358250 0.227840758211 0.896183153689
         H 0.772173318390 0.396189392847 0.637055963356
         H 0.603804050287 0.137089872332 0.727836226489
         H 0.727828470909 0.603811815613 0.137056819023
         H 0.896196010135 0.862910104278 0.227837672741
         H 0.396196503265 0.637090090634 0.772162233700
         H 0.137076123185 0.727840762109 0.603815982848
         H 0.227828969886 0.896188585908 0.862942724881
         H 0.637075505311 0.772159890849 0.396183697495
      &END COORD
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      CHARGE 0
      MULTIPLICITY 1
      UKS .FALSE.
      &KPOINTS
         SCHEME MONKHORST-PACK 3 3 3
         GAMMA_CENTERED .TRUE.
         SYMMETRY .TRUE.
         EPS_SYMMETRY 1.0E-4
         FULL_GRID .FALSE.
         INVERSION_SYMMETRY_ONLY .FALSE.
         WAVEFUNCTIONS COMPLEX
         PARALLEL_GROUP_SIZE 0
      &END KPOINTS
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               TYPE DFTD3(BJ)
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .TRUE.
               NATIVE_GRID_GAPW_DENSITY_PARTITION HARD_MINUS_SOFT
               PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         SCF_GUESS ATOMIC
         EPS_SCF 5.0E-7
         MAX_SCF 300
         &OT
            MINIMIZER DIIS
            ALGORITHM IRAC
            PRECONDITIONER FULL_ALL
            ENERGY_GAP 0.001
            STEPSIZE 0.10
         &END OT
         &OUTER_SCF
            EPS_SCF 5.0E-7
            MAX_SCF 2
         &END OUTER_SCF
         &PRINT
            &RESTART
               BACKUP_COPIES 1
               &EACH
                  QS_SCF 1
               &END EACH
            &END RESTART
         &END PRINT
      &END SCF
      &QS
         METHOD GAPW
         EPS_DEFAULT 1.0E-12
         EPSFIT 1.0E-4
         EPSISO 1.0E-12
         EPSRHO0 1.0E-6
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
      &END QS
      &MGRID
         CUTOFF 800
         REL_CUTOFF 60
         NGRIDS 5
      &END MGRID
      &POISSON
         PERIODIC XYZ
         POISSON_SOLVER PERIODIC
      &END POISSON
   &END DFT
&END FORCE_EVAL
