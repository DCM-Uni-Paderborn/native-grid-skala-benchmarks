&GLOBAL
   PROJECT_NAME x23_CO2_molecule_gapwxc-gth
   RUN_TYPE ENERGY
   PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND C
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
         POTENTIAL GTH-PBE-q4
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.52
      &END KIND
      &KIND O
         BASIS_SET TZV2P-MOLOPT-PBE-GTH-q6
         POTENTIAL GTH-PBE-q6
         RADIAL_GRID 150
         LEBEDEV_GRID 770
         HARD_EXP_RADIUS 1.40
      &END KIND
      &CELL
         A 26.359330000000 0.000000000000 0.000000000000
         B 0.000000000000 26.359970000000 0.000000000000
         C 0.000000000000 0.000000000000 26.329610000000
         PERIODIC NONE
      &END CELL
      &COORD

         C 13.180280000000 13.179210000000 13.166440000000
         O 13.859330000000 12.500000000000 12.500000000000
         O 12.500000000000 13.859970000000 13.829610000000
      &END COORD
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      CHARGE 0
      MULTIPLICITY 1
      UKS .FALSE.
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               TYPE DFTD3(BJ)
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .FALSE.
               NATIVE_GRID_GAPW_DENSITY_PARTITION HARD_MINUS_SOFT
               PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         SCF_GUESS ATOMIC
         EPS_SCF 5.0E-7
         MAX_SCF 300
         &OT
            MINIMIZER DIIS
            PRECONDITIONER FULL_KINETIC
            ENERGY_GAP 0.001
            STEPSIZE 0.10
         &END OT
         &OUTER_SCF
            EPS_SCF 5.0E-7
            MAX_SCF 2
         &END OUTER_SCF
         &PRINT
            &RESTART
               BACKUP_COPIES 1
               &EACH
                  QS_SCF 1
               &END EACH
            &END RESTART
         &END PRINT
      &END SCF
      &QS
         METHOD GAPW_XC
         EPS_DEFAULT 1.0E-12
         EPSFIT 1.0E-4
         EPSISO 1.0E-12
         EPSRHO0 1.0E-6
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
      &END QS
      &MGRID
         CUTOFF 800
         REL_CUTOFF 60
         NGRIDS 5
      &END MGRID
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
   &END DFT
&END FORCE_EVAL
