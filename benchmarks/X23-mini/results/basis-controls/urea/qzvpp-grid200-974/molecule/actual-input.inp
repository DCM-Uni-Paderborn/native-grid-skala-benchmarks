&GLOBAL
   PROJECT_NAME urea_ae_qzvpp_grid200_974_molecule
   RUN_TYPE ENERGY
   PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
   METHOD QUICKSTEP
   &SUBSYS
      &KIND C
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 200
         LEBEDEV_GRID 974
         HARD_EXP_RADIUS 1.52
      &END KIND
      &KIND O
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 200
         LEBEDEV_GRID 974
         HARD_EXP_RADIUS 1.40
      &END KIND
      &KIND N
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 200
         LEBEDEV_GRID 974
         HARD_EXP_RADIUS 1.40
      &END KIND
      &KIND H
         BASIS_SET QZVPP-MOLOPT-PBE-ae
         POTENTIAL ALL
         RADIAL_GRID 200
         LEBEDEV_GRID 974
         HARD_EXP_RADIUS 1.00
      &END KIND
      &CELL
         A 28.500140000000 0.000000000000 0.000000000000
         B 0.000000000000 28.119440000000 0.000000000000
         C 0.000000000000 0.000000000000 25.624400000000
         PERIODIC NONE
      &END CELL
      &COORD

         C 14.387760000000 14.558670000000 12.813140000000
         O 14.997140000000 15.619440000000 12.812480000000
         N 13.035470000000 14.464430000000 12.510830000000
         N 14.988260000000 13.343850000000 13.116220000000
         H 12.500000000000 13.710650000000 12.926420000000
         H 12.564140000000 15.361000000000 12.500000000000
         H 14.603240000000 12.500000000000 12.707710000000
         H 16.000140000000 13.387130000000 13.124400000000
      &END COORD
   &END SUBSYS
   &DFT
      BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
      POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
      CHARGE 0
      MULTIPLICITY 1
      UKS .FALSE.
      &XC
         &VDW_POTENTIAL
            POTENTIAL_TYPE PAIR_POTENTIAL
            &PAIR_POTENTIAL
               TYPE DFTD3(BJ)
               PARAMETER_FILE_NAME dftd3.dat
               REFERENCE_FUNCTIONAL B3LYP
               R_CUTOFF 20.0
            &END PAIR_POTENTIAL
         &END VDW_POTENTIAL
         &XC_FUNCTIONAL
            &GAUXC
               MODEL SKALA
               NATIVE_GRID .TRUE.
               NATIVE_GRID_ATOM_PARTITION SMOOTH
               NATIVE_GRID_DIAGNOSTICS .TRUE.
               NATIVE_GRID_LAYOUT ATOM_COMPOSITE
               NATIVE_GRID_USE_CUDA .FALSE.
            &END GAUXC
         &END XC_FUNCTIONAL
      &END XC
      &SCF
         SCF_GUESS ATOMIC
         EPS_SCF 5.0E-7
         MAX_SCF 300
         &OT
            MINIMIZER DIIS
            PRECONDITIONER FULL_ALL
            ENERGY_GAP 0.001
            STEPSIZE 0.05
         &END OT
         &OUTER_SCF
            EPS_SCF 5.0E-7
            MAX_SCF 2
         &END OUTER_SCF
         &PRINT
            &RESTART
               BACKUP_COPIES 1
               &EACH
                  QS_SCF 1
               &END EACH
            &END RESTART
         &END PRINT
      &END SCF
      &QS
         METHOD GAPW
         EPS_DEFAULT 1.0E-14
         EPSFIT 1.0E-4
         EPSISO 1.0E-12
         EPSRHO0 1.0E-6
         GAPW_1C_BASIS EXT_SMALL
         GAPW_ACCURATE_XCINT .TRUE.
         LMAXN0 4
      &END QS
      &MGRID
         CUTOFF 800
         REL_CUTOFF 60
         NGRIDS 5
      &END MGRID
      &POISSON
         PERIODIC NONE
         POISSON_SOLVER ANALYTIC
      &END POISSON
   &END DFT
&END FORCE_EVAL
