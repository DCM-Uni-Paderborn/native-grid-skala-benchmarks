          SPECIAL_POINT mesh26 -0.16666666666667 0.16666666666667 0.00000000000000
          SPECIAL_POINT mesh27 0.25000000000000 0.25000000000000 0.00000000000000
          SPECIAL_POINT mesh28 0.33333333333333 0.25000000000000 0.00000000000000
