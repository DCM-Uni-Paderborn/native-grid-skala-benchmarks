          SPECIAL_POINT mesh63 -0.41666666666667 0.50000000000000 0.08333333333333
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 1
          SPECIAL_POINT mesh64 0.50000000000000 0.33333333333333 0.16666666666667
          SPECIAL_POINT mesh65 -0.41666666666667 0.33333333333333 0.16666666666667
          SPECIAL_POINT mesh66 -0.33333333333333 0.33333333333333 0.16666666666667
          SPECIAL_POINT mesh67 -0.41666666666667 0.41666666666667 0.16666666666667
          SPECIAL_POINT mesh68 -0.33333333333333 0.41666666666667 0.16666666666667
          SPECIAL_POINT mesh69 -0.25000000000000 0.41666666666667 0.16666666666667
          SPECIAL_POINT mesh70 -0.33333333333333 0.50000000000000 0.16666666666667
          SPECIAL_POINT mesh71 -0.25000000000000 0.50000000000000 0.25000000000000
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT GAMMA 0.00000000000000 0.00000000000000 0.00000000000000
          SPECIAL_POINT X -0.50000000000000 -0.50000000000000 0.00000000000000
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT X -0.50000000000000 -0.50000000000000 0.00000000000000
          SPECIAL_POINT U -0.37500000000000 -0.37500000000000 0.25000000000000
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT K -0.37500000000000 0.00000000000000 0.37500000000000
