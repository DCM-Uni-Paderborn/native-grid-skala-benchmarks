&GLOBAL
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  PROJECT_NAME lc10_gap_BN_gapwxc_gth_tzv2p
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &SUBSYS
    &KIND B
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q3
      POTENTIAL GTH-PBE-q3
      RADIAL_GRID 150
      LEBEDEV_GRID 770
      HARD_EXP_RADIUS 1.52
    &END KIND
    &KIND N
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q5
      POTENTIAL GTH-PBE-q5
      RADIAL_GRID 150
      LEBEDEV_GRID 770
      HARD_EXP_RADIUS 1.40
    &END KIND
    &CELL
      ABC 2.55689812077056 2.55689812077056 2.55689812077056
      ALPHA_BETA_GAMMA 60 60 60
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      B 0 0 0
      N 0.25 0.25 0.25
    &END COORD
  &END SUBSYS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
    POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
    CHARGE 0
    MULTIPLICITY 1
    UKS .FALSE.
    &XC
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL B3LYP
          R_CUTOFF 20.0
          TYPE DFTD3(BJ)
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          NATIVE_GRID .TRUE.
          NATIVE_GRID_ATOM_PARTITION SMOOTH
          NATIVE_GRID_DIAGNOSTICS .TRUE.
          NATIVE_GRID_GAPW_DENSITY_PARTITION HARD_MINUS_SOFT
          NATIVE_GRID_LAYOUT ATOM_COMPOSITE
          PSEUDOPOTENTIAL_GAPW_REPRESENTATION PAW_ONE_CENTER
          NATIVE_GRID_USE_CUDA .FALSE.
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
    &QS
      EPSFIT 1.0E-4
      EPSISO 1.0E-12
      EPSRHO0 1.0E-6
      GAPW_1C_BASIS EXT_SMALL
      GAPW_ACCURATE_XCINT .TRUE.
      LMAXN0 4
      METHOD GAPW_XC
      EPS_DEFAULT 1.0E-14
    &END QS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &MGRID
      CUTOFF 800
      NGRIDS 5
      REL_CUTOFF 60
    &END MGRID
    &KPOINTS
      SCHEME MONKHORST-PACK 6 6 6
      GAMMA_CENTERED .FALSE.
      SYMMETRY .TRUE.
      FULL_GRID .FALSE.
      INVERSION_SYMMETRY_ONLY .FALSE.
      SYMMETRY_BACKEND K290
      SYMMETRY_REDUCTION_METHOD K290
      EPS_SYMMETRY 1.0E-8
      PARALLEL_GROUP_SIZE -1
      WAVEFUNCTIONS COMPLEX
      VERBOSE .TRUE.
    &END KPOINTS
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 600
      SCF_GUESS ATOMIC
      CHOLESKY OFF
      EPS_EIGVAL 1.0E-6
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.10
        BETA 1.50
        METHOD DIRECT_P_MIXING
        NBUFFER 8
      &END MIXING
    &END SCF
    &PRINT
      &BAND_STRUCTURE
        FILE_NAME bands.bs
        ADDED_MOS 8
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 1
          SPECIAL_POINT mesh0 0.00000000000000 0.00000000000000 0.00000000000000
          SPECIAL_POINT mesh1 0.08333333333333 0.00000000000000 0.00000000000000
          SPECIAL_POINT mesh2 0.16666666666667 0.00000000000000 0.00000000000000
          SPECIAL_POINT mesh3 0.25000000000000 0.00000000000000 0.00000000000000
          SPECIAL_POINT mesh4 0.33333333333333 0.00000000000000 0.00000000000000
          SPECIAL_POINT mesh5 0.41666666666667 0.00000000000000 0.00000000000000
          SPECIAL_POINT mesh6 0.50000000000000 0.00000000000000 0.00000000000000
          SPECIAL_POINT mesh7 0.08333333333333 0.08333333333333 0.00000000000000
          SPECIAL_POINT mesh8 0.16666666666667 0.08333333333333 0.00000000000000
