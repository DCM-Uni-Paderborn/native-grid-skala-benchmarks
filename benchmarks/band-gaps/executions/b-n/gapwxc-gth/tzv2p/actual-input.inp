        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT GAMMA 0.00000000000000 0.00000000000000 0.00000000000000
          SPECIAL_POINT L 0.00000000000000 0.00000000000000 0.50000000000000
