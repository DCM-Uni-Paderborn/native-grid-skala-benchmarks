          SPECIAL_POINT mesh41 -0.41666666666667 0.41666666666667 0.00000000000000
          SPECIAL_POINT mesh42 0.50000000000000 0.50000000000000 0.00000000000000
          SPECIAL_POINT mesh43 0.25000000000000 0.16666666666667 0.08333333333333
          SPECIAL_POINT mesh44 0.33333333333333 0.16666666666667 0.08333333333333
          SPECIAL_POINT mesh45 0.41666666666667 0.16666666666667 0.08333333333333
          SPECIAL_POINT mesh46 0.50000000000000 0.16666666666667 0.08333333333333
          SPECIAL_POINT mesh47 -0.41666666666667 0.16666666666667 0.08333333333333
          SPECIAL_POINT mesh48 0.33333333333333 0.25000000000000 0.08333333333333
          SPECIAL_POINT mesh49 0.41666666666667 0.25000000000000 0.08333333333333
          SPECIAL_POINT mesh50 0.50000000000000 0.25000000000000 0.08333333333333
