        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 1
          SPECIAL_POINT mesh32 -0.33333333333333 0.25000000000000 0.00000000000000
          SPECIAL_POINT mesh33 -0.25000000000000 0.25000000000000 0.00000000000000
          SPECIAL_POINT mesh34 0.33333333333333 0.33333333333333 0.00000000000000
          SPECIAL_POINT mesh35 0.41666666666667 0.33333333333333 0.00000000000000
