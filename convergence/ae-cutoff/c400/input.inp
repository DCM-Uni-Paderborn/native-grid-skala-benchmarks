&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME h2o_gapw_ae_c400
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME POTENTIAL_UZH_2026.2
    UKS FALSE
    &MGRID
      CUTOFF 400
      NGRIDS 5
      REL_CUTOFF 60
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER ANALYTIC
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-14
      EPSFIT 1.0E-4
      EPSISO 1.0E-12
      EPSRHO0 1.0E-6
      GAPW_1C_BASIS EXT_SMALL
      GAPW_ACCURATE_XCINT T
      LMAXN0 4
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 200
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.30
        METHOD DIRECT_P_MIXING
        NBROYDEN 15
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          NATIVE_GRID T
          NATIVE_GRID_ATOM_PARTITION SMOOTH
          NATIVE_GRID_DIAGNOSTICS T
          NATIVE_GRID_LAYOUT ATOM_COMPOSITE
          NATIVE_GRID_USE_CUDA T
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR
      COMPONENTS
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC 20.0 20.0 20.0
      PERIODIC NONE
    &END CELL
    &COORD
      O 0.0000000000 0.0000000000 0.0000000000
      H 0.0000000000 0.7586020000 0.5042840000
      H 0.0000000000 -0.7586020000 0.5042840000
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
    &KIND H
      BASIS_SET QZVPP-MOLOPT-PBE-ae
      HARD_EXP_RADIUS 1.00
      LEBEDEV_GRID 50
      POTENTIAL ALL
      RADIAL_GRID 50
    &END KIND
    &KIND O
      BASIS_SET QZVPP-MOLOPT-PBE-ae
      HARD_EXP_RADIUS 1.40
      LEBEDEV_GRID 50
      POTENTIAL ALL
      RADIAL_GRID 50
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
