# Refresh the independent ESI, including its input files, before resolving main-text references.
my $esi_status = system('latexmk', '-norc', '-pdf', '-quiet',
                        '-interaction=nonstopmode', '-halt-on-error',
                        '-outdir=esi-build', 'supplementary_information.tex');
die "ESI compilation failed; cross-references were not refreshed\n" if $esi_status;
